# Copy to `.env` for local development. Every value here has a working default
# in app/config.py, so this file is optional locally.

# Where SQLite lives. Defaults to backend/signal_clone.db.
# DATABASE_URL=sqlite:///./signal_clone.db

# Sign JWTs with this. MUST be set to a random value in production.
# JWT_SECRET=change-me-to-something-random

# How long a session lasts, in minutes. Default is 30 days.
# JWT_EXPIRE_MINUTES=43200

# The single code the mocked OTP flow accepts.
# MOCK_OTP_CODE=123456

# Comma-separated browser origins allowed to call the API.
# Any *.vercel.app host is additionally matched by regex in app/main.py.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Seed demo data when the database has no users.
# SEED_ON_STARTUP=true

# Verbose SQL logging.
# DEBUG=false
